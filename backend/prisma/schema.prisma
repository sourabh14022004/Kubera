// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ============================================================
//USER
// ============================================================
enum AuthType {
  PERSONAL
  UNIVERSITY
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String   
  email         String    @unique
  googleId      String?   @unique @map("google_id")
  profileImage  String?   @map("profile_image")
  isActive      Boolean   @default(true) @map("is_active")
  authType AuthType @default(UNIVERSITY) @map("auth_type")

  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(6)
  
  // Role assigned to this User
  roleAssignments UserRoleAssignment[] @relation("AssignedUserRoles")

  // Roles granted by this user to others
  grantedRoleAssignments UserRoleAssignment[] @relation("RoleAssignmentGrantedBy")

  @@map("users")
}


// ============================================================
// ROLE
// ============================================================

model Role {

  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?


  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Users who have this role
  assignments UserRoleAssignment[]  

  @@map("roles")   
}



// ============================================================
// USER ROLE ASSIGNMENT
// ============================================================

model UserRoleAssignment {
    id            String   @id @default(uuid()) @db.Uuid

    // Relate to User
    userId        String   @map("user_id") @db.Uuid
    roleId        String   @map("role_id") @db.Uuid

    // Who granted this role
    // Nullable only for initial system bootstrap
    assignedById String? @map("assigned_by_id") @db.Uuid

    assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
    expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
    revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)


    // Relationship with the user receiving the role
    user User @relation("AssignedUserRoles",  fields: [userId], references: [id], onDelete: Restrict)

    // Relationship with the role being assigned
    role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

    // Relationship with the user granting the role
    assignedBy User? @relation( "RoleAssignmentGrantedBy", fields: [assignedById], references: [id], onDelete: Restrict)




    @@index([userId, roleId, revokedAt])
    @@index([roleId, revokedAt])
    @@index([assignedById])

    @@map("user_role_assignments")
}
